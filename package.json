{
    "name": "mediac",
    "version": "2.0.0",
    "type": "module",
    "description": "MediaCli is a multimedia file processing tool that utilizes ffmpeg and exiftool, among others, to compress/convert/rename/delete/organize media files, including images, videos, and audio.",
    "main": "index.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "test": "node --test \"test/*.js\"",
        "start": "node index.js",
        "check": "node ./scripts/check_syntax.cjs",
        "lint": "eslint . --ext .js",
        "lint:fix": "eslint . --ext .js --fix",
        "prettier:fix": "prettier --write ."
    },
    "files": [
        "index.js",
        "scripts",
        "lib",
        "cmd",
        "assets",
        "presets.yaml"
    ],
    "bin": {
        "mediac": "./index.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mcxiaoke/media-cli.js.git"
    },
    "keywords": [
        "exif",
        "exiftool",
        "image",
        "photo",
        "raw",
        "jpeg",
        "picture",
        "mp4",
        "video",
        "media",
        "ffmpeg",
        "ffprobe",
        "filename",
        "zip",
        "unicode",
        "encoding",
        "charset",
        "gbk",
        "shift_jis",
        "utf8",
        "file",
        "cjk",
        "chinese",
        "hanzi",
        "japanese"
    ],
    "author": "Big Cat <github@mcxiaoke.com>",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/mcxiaoke/media-cli.js/issues"
    },
    "homepage": "https://github.com/mcxiaoke/media-cli.js#readme",
    "publishConfig": {
        "registry": " https://registry.npmjs.org"
    },
    "dependencies": {
        "atomically": "^2.0.3",
        "chalk": "^5.3.0",
        "chardet": "^2.0.0",
        "chinese-conv": "^1.1.0",
        "cli-progress": "^3.12.0",
        "dayjs": "^1.11.19",
        "execa": "^9.6.1",
        "exiftool-vendored": "^35.6.0",
        "fdir": "^6.5.0",
        "file-type": "^19.0.0",
        "fs-extra": "^11.3.3",
        "glob": "^13.0.6",
        "global-agent": "^3.0.0",
        "got": "^14.2.1",
        "iconv-lite": "^0.6.3",
        "image-size": "^1.1.1",
        "inquirer": "^9.2.19",
        "js-xxhash": "^3.0.1",
        "js-yaml": "^4.1.1",
        "loglevel": "^1.9.1",
        "loglevel-plugin-prefix": "^0.8.4",
        "music-metadata": "^7.14.0",
        "node-emoji": "^2.1.3",
        "p-filter": "^4.1.0",
        "p-map": "^7.0.4",
        "sharp": "^0.34.5",
        "throat": "^6.0.2",
        "unzipper": "^0.11.3",
        "upath": "^2.0.1",
        "which": "^4.0.0",
        "xxhash-wasm": "^1.1.0",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.2.3",
        "c8": "^11.0.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.3.0",
        "prettier": "^3.8.1"
    }
}

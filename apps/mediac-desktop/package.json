{
  "name": "mediac-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MediaCli FFmpeg desktop client",
  "author": "Big Cat <mcxiaoke@foxmail.com>",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "ensure:electron": "electron --version",
    "predev": "npm run ensure:electron",
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --remote-debugging-port=9222",
    "prebuild": "npm run ensure:electron",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
